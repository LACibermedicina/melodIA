# Copie para ".env" e ajuste. Nenhum segredo é necessário para rodar.
PORT=3000
# Use 127.0.0.1 para acesso só neste computador; 0.0.0.0 para a rede (coloque HTTPS na frente).
HOST=127.0.0.1
DATA_DIR=./data
SESSION_DAYS=7
# Permite que qualquer pessoa crie conta. Padrão: false (só o administrador cria usuários).
ALLOW_SIGNUP=false
# Mude para true quando o acesso for por HTTPS.
COOKIE_SECURE=false
MAX_BODY_MB=10
