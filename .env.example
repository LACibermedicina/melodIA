# Copie para ".env" e ajuste. Nenhum segredo é necessário para rodar.
PORT=3000
# Use 127.0.0.1 para acesso só neste computador; 0.0.0.0 para a rede (coloque HTTPS na frente).
HOST=127.0.0.1
DATA_DIR=./data
SESSION_DAYS=7
# Permite que qualquer pessoa crie conta. Padrão: false (só o administrador cria usuários).
ALLOW_SIGNUP=false
# Mude para true quando o acesso for por HTTPS.
COOKIE_SECURE=false
MAX_BODY_MB=10
# true quando o app fica atrás de nginx/Caddy (usa o IP real do visitante no limite de tentativas).
TRUST_PROXY=false

# Transcrição de letra no servidor (opcional). Use uma chave NOVA; ela nunca vai para o navegador.
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_MAX_MB=25

# IA no servidor (opcional). Use uma chave NOVA; ela nunca vai para o navegador.
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=
# AI_URL=

# ---- Canto natural (preenchidos pelo deploy na VPS) ----
# CANTO_PORT=3290
# CANTO_MODELS=/var/lib/melodia/canto-modelos
# GPU externa opcional para o timbre importado (Seed-VC): hf ou replicate
# CANTO_GPU=hf
# CANTO_GPU_SPACE=Plachta/Seed-VC
# HF_TOKEN=
# CANTO_GPU=replicate
# REPLICATE_API_TOKEN=
# CANTO_GPU_REPLICATE_VERSION=
# CANTO_GPU_REPLICATE_INPUT={"source_audio":"{source}","target_audio":"{reference}","f0_condition":true}
